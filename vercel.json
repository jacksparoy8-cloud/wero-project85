{
  "version": 2,
  "buildCommand": "cd backend-nodejs && npm install",
  "framework": "express",
  "public": "backend-nodejs/public",
  "env": {
    "NODE_ENV": "production",
    "PORT": "3000"
  },
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs18.x",
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
