{
  "version": 2,
  "buildCommand": "cd backend-nodejs && npm install",
  "framework": "express",
  "public": "backend-nodejs/public",
  "env": {
    "NODE_ENV": "production",
    "PORT": "3000"
  },
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs18.x",
      "memory": 1024,
      "maxDuration": 60
    },
    "backend-nodejs/server.js": {
      "runtime": "nodejs18.x",
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/backend-nodejs/server.js"
    },
    {
      "source": "/:path*",
      "destination": "/backend-nodejs/server.js"
    }
  ]
}
