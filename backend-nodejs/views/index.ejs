<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lydia – Paiement Instantané & Sécurisé</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: linear-gradient(135deg, #FFF 0%, #E8F0FF 100%); color: #0A0E27; overflow-x: hidden !important; width: 100%; }

    .container { width: 100%; max-width: 1280px; margin: 0 auto; padding: 0 40px; box-sizing: border-box; }
    
    header { position: sticky; top: 0; z-index: 1000; background: linear-gradient(135deg, #FFF 0%, #E8F0FF 100%); padding: 12px 0; box-shadow: 0 2px 20px rgba(0,0,0,0.08); }
    .header-container { width: 100%; max-width: 1280px; margin: 0 auto; padding: 0 40px; display: flex; justify-content: space-between; align-items: center; box-sizing: border-box; }
    .logo { font-size: 32px; font-weight: 900; color: #0A0E27; }
    .desktop-nav { display: flex; gap: 10px; }
    .desktop-nav a { color: #0A0E27; text-decoration: none; font-weight: 600; padding: 10px 18px; border-radius: 12px; }
    .mobile-menu-btn { display: none; background: 0; border: 0; font-size: 24px; cursor: pointer; }
    
    .hero { padding: 80px 0 60px; text-align: center; }
    .hero .container { padding: 0; }
    .hero-wrapper { display: flex; flex-direction: column; align-items: center; gap: 40px; padding: 0 40px; }
    
    /* iPhone 17 Design */
    .iphone-frame { width: 280px; height: 590px; background: linear-gradient(135deg, #1a1a1a 0%, #0a0a0a 100%); border-radius: 55px; border: 12px solid #0a0a0a; margin: 0 auto; box-shadow: 0 0 0 1px #1a1a1a, 0 20px 60px rgba(0,0,0,0.5), inset 0 0 0 1px rgba(255,255,255,0.1); overflow: hidden; position: relative; }
    
    .iphone-frame::before { 
      content: ''; 
      position: absolute; 
      top: 0; 
      left: 50%; 
      transform: translateX(-50%); 
      width: 130px; 
      height: 32px; 
      background: #000; 
      border-radius: 0 0 28px 28px; 
      z-index: 10; 
    }
    
    .iphone-screen { width: 100%; height: 100%; background: linear-gradient(180deg, #1a1a2e 0%, #0f3460 100%); display: flex; flex-direction: column; overflow: hidden; position: relative; }
    
    .status-bar { display: flex; justify-content: space-between; padding: 8px 16px; color: #FFF; font-size: 12px; font-weight: 600; height: 44px; align-items: center; padding-top: 20px; }
    .status-left { display: flex; gap: 4px; align-items: center; font-size: 11px; }
    .status-right { display: flex; gap: 4px; align-items: center; font-size: 11px; }
    
    .numpad-screen { flex: 1; display: flex; flex-direction: column; padding: 12px; gap: 10px; }
    
    .amount-display { text-align: center; }
    .amount-label { color: #999; font-size: 9px; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 6px; }
    .amount-value { font-size: 56px; font-weight: 900; color: #FFF; font-family: monospace; }
    .amount-currency { font-size: 16px; color: #0066FF; }
    
    .numpad { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .numpad-btn { background: #333; color: #FFF; border: none; padding: 10px; border-radius: 10px; font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
    .numpad-btn:active { background: #444; transform: scale(0.95); }
    
    .action-buttons { display: flex; gap: 8px; margin-top: 8px; }
    .btn-ask { flex: 1; background: linear-gradient(135deg, #FF6B6B 0%, #FF5252 100%); color: #FFF; border: none; padding: 14px; border-radius: 12px; font-weight: 700; font-size: 14px; cursor: pointer; box-shadow: 0 4px 15px rgba(255,107,107,0.3); }
    .btn-send { flex: 1; background: linear-gradient(135deg, #0066FF 0%, #0052CC 100%); color: #FFF; border: none; padding: 14px; border-radius: 12px; font-weight: 700; font-size: 14px; cursor: pointer; box-shadow: 0 4px 15px rgba(0,102,255,0.3); }

    .hero h1 { font-size: 64px; font-weight: 900; margin-bottom: 20px; }
    .hero p { font-size: 20px; color: rgba(0,0,0,0.7); margin-bottom: 30px; }
    .hero-buttons { display: flex; flex-direction: column; gap: 16px; max-width: 420px; margin: 40px auto; }
    .btn-primary, .btn-secondary { padding: 18px 40px; border-radius: 16px; font-weight: 700; text-decoration: none; border: 2px solid transparent; cursor: pointer; font-size: 16px; transition: all 0.3s; }
    .btn-primary { background: #000; color: #0066FF; box-shadow: 0 20px 40px rgba(0,0,0,0.2); }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 25px 50px rgba(0,0,0,0.3); }
    .btn-secondary { background: transparent; color: #0A0E27; border-color: #0A0E27; }
    .btn-secondary:hover { background: rgba(0,0,0,0.05); }

    .notification { background: rgba(255,255,255,0.9); padding: 16px 32px; border-radius: 50px; display: inline-flex; align-items: center; gap: 12px; font-weight: 600; margin: 30px auto; box-shadow: 0 20px 40px rgba(0,0,0,0.15); }

    .info-section { margin: 80px 0; }
    .section-title { text-align: center; font-size: 36px; font-weight: 900; margin-bottom: 50px; }
    .info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 30px; }
    .info-card { background: rgba(255,255,255,0.9); border-radius: 20px; padding: 40px 30px; text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,0.1); transition: all 0.3s; }
    .info-card:hover { transform: translateY(-8px); box-shadow: 0 20px 50px rgba(0,0,0,0.15); }
    .info-card i { font-size: 48px; color: #10B981; margin-bottom: 20px; }
    .info-card h3 { font-size: 20px; font-weight: 700; margin-bottom: 15px; }
    .info-card p { font-size: 15px; color: #666; }

    footer { background: #0A0E27; color: #FFF; padding: 80px 0 40px; }

    @media (max-width: 768px) {
      .desktop-nav { display: none; }
      .mobile-menu-btn { display: block; }
      .container { padding: 0 20px; }
      .header-container { padding: 0 20px; }
      .hero-wrapper { padding: 0 20px; }
      .hero h1 { font-size: 36px; }
      .hero p { font-size: 16px; }
      .info-grid { grid-template-columns: 1fr; }
      .iphone-frame { width: 240px; height: 490px; border: 10px solid #000; border-radius: 42px; }
      .amount-value { font-size: 42px; }
    }

    @media (max-width: 640px) {
      body { width: 100vw; }
      .container { padding: 0 10px !important; }
      .header-container { padding: 0 10px !important; }
      header { padding: 8px 0; }
      .logo { font-size: 20px; }
      .hero { padding: 15px 0; }
      .hero-wrapper { padding: 0 10px; gap: 15px; }
      .hero h1 { font-size: 22px; margin-bottom: 8px; }
      .hero p { font-size: 13px; margin-bottom: 10px; }
      .hero-buttons { margin: 10px 0; gap: 8px; }
      .btn-primary, .btn-secondary { padding: 10px 14px; font-size: 12px; }
      .iphone-frame { width: 160px; height: 327px; border: 6px solid #000; border-radius: 32px; }
      .iphone-frame::before { width: 100px; height: 18px; }
      .status-bar { padding: 6px 8px; font-size: 8px; height: 24px; padding-top: 10px; }
      .numpad-screen { padding: 12px; gap: 10px; }
      .amount-value { font-size: 28px; }
      .amount-currency { font-size: 14px; }
      .numpad-btn { padding: 10px; font-size: 14px; }
      .btn-ask, .btn-send { padding: 10px; font-size: 11px; }
      .notification { padding: 10px 16px; font-size: 12px; margin: 10px auto; }
      .section-title { font-size: 20px; margin-bottom: 15px; }
      .info-card { padding: 12px 10px; }
      .info-card i { font-size: 30px; margin-bottom: 8px; }
      .info-card h3 { font-size: 14px; }
      .info-card p { font-size: 12px; }
      footer { padding: 30px 0 15px; }
    }
  </style>
</head>
<body>

  <header>
    <div class="header-container">
      <div class="logo"><img src="https://upload.wikimedia.org/wikipedia/fr/c/c7/Logo_Lydia.png" alt="Lydia" style="height: 40px; width: auto;"></div>
      <nav class="desktop-nav">
        <a href="/">Accueil</a>
      </nav>
      <button class="mobile-menu-btn" aria-label="Menu">☰</button>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container">
        <div class="hero-wrapper">
          <div class="iphone-frame" style="background: none; border: none; box-shadow: none; width: 280px; height: auto; padding: 0; margin: 0 auto;">
            <img src="https://cdn.prod.website-files.com/65de25775cac0159d88f2585/6a3ba3a92378059360bcd479_mock.avif" alt="Mockup Lydia" style="width: 100%; height: auto; border-radius: 55px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); display: block;"><div class="iphone-screen" style="display: none;">
              <div class="status-bar">
                <div class="status-left">
                  <span>📶 📡</span>
                </div>
                <div class="status-right">
                  <span>9:42</span>
                </div>
              </div>
              
              <div class="numpad-screen">
                <div class="amount-display">
                  <div class="amount-label">Montant</div>
                  <div>
                    <span class="amount-currency">€</span><span class="amount-value">250</span>
                  </div>
                </div>
                
                <div class="numpad">
                  <button class="numpad-btn">1</button>
                  <button class="numpad-btn">2</button>
                  <button class="numpad-btn">3</button>
                  <button class="numpad-btn">4</button>
                  <button class="numpad-btn">5</button>
                  <button class="numpad-btn">6</button>
                  <button class="numpad-btn">7</button>
                  <button class="numpad-btn">8</button>
                  <button class="numpad-btn">9</button>
                  <button class="numpad-btn" style="color: #0066FF;">.</button>
                  <button class="numpad-btn">0</button>
                  <button class="numpad-btn">⌫</button>
                </div>
                
                <div class="action-buttons">
                  <button class="btn-ask">Demander</button>
                  <button class="btn-send">Envoyer</button>
                </div>
              </div>
            </div>
          </div>

          <div style="text-align: center; max-width: 600px;">
            <h1>Lydia</h1>
            <p>Le paiement instantané révolutionnaire pour tous</p>
            <div class="notification">
              ⚡ Transférez de l'argent en moins de 10 secondes
            </div>
            <div class="hero-buttons">
              <a href="/accords" class="btn-primary">▶ ACTIVEZ MAINTENANT</a>
              <a href="/accords" class="btn-secondary">💰 RÉCUPÉRER MON ARGENT</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="info-section">
      <div class="container">
        <h2 class="section-title">🔒 Sécurité & Confiance</h2>
        <div class="info-grid">
          <div class="info-card">
            <i class="fas fa-shield-alt"></i>
            <h3>Cryptage 256-bit</h3>
            <p>Protection SSL/TLS maximale pour vos transactions</p>
          </div>
          <div class="info-card">
            <i class="fas fa-lock"></i>
            <h3>Données Sécurisées</h3>
            <p>Conformité PCI DSS et normes bancaires</p>
          </div>
          <div class="info-card">
            <i class="fas fa-user-check"></i>
            <h3>Authentification 2FA</h3>
            <p>Vérification en deux étapes</p>
          </div>
        </div>
      </div>
    </section>

    <section class="info-section">
      <div class="container">
        <h2 class="section-title">✨ Nos Avantages</h2>
        <div class="info-grid">
          <div class="info-card">
            <i class="fas fa-zap"></i>
            <h3>Transferts Instantanés</h3>
            <p>Votre argent arrive en moins de 10 secondes</p>
          </div>
          <div class="info-card">
            <i class="fas fa-euro-sign"></i>
            <h3>Frais Inexistants</h3>
            <p>Aucuns frais pour tous vos transferts</p>
          </div>
          <div class="info-card">
            <i class="fas fa-globe"></i>
            <h3>Envois Internationaux</h3>
            <p>Vers plus de 150 pays</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">
      <div style="text-align: center;">
        <h3 style="color: #0066FF; margin-bottom: 10px; font-size: 20px;">Lydia</h3>
        <p>Le futur du paiement instantané</p>
        <div style="text-align: center; padding-top: 30px; border-top: 1px solid rgba(255,255,255,0.1); opacity: 0.6; font-size: 14px; margin-top: 30px;">
          <p>&copy; 2024 Lydia. Tous droits réservés.</p>
        </div>
      </div>
    </div>
  </footer>

</body>
</html>
