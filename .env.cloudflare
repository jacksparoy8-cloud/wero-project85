# ============================================
# CONFIGURATION CLOUDFLARE TUNNEL - WERO
# ============================================

# 1️⃣ CRÉER UN TUNNEL CLOUDFLARE
# Visite : https://dash.cloudflare.com/profile/api-tokens
# Ou utilise cloudflared locally:
#   cloudflared tunnel login
#   cloudflared tunnel create wero
#
# Récupère le TOKEN depuis :
#   https://dash.cloudflare.com/tunnels ou avec: cloudflared tunnel token wero

# 2️⃣ AJOUTE TON TOKEN ICI
CLOUDFLARE_TOKEN=eyJhIjoiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# 3️⃣ TELEGRAM (déjà configuré dans .env)
TELEGRAM_BOT_TOKEN=8600263990:AAEHyRgZ9zl_vygyKSzh6p6BX8RvQjToMYM
TELEGRAM_CHAT_ID=8176081750

# ============================================
# COMMANDES DE DÉPLOIEMENT
# ============================================

# Démarrer avec tunnel :
# docker compose --env-file .env.cloudflare up -d

# Vérifier le statut du tunnel :
# docker compose logs nodejs | grep cloudflared

# Accéder à l'app :
# https://votre-domaine.workers.dev (voir le dashboard Cloudflare)

# ============================================
# OBTENIR LE TOKEN
# ============================================

# Option 1: Via Cloudflare Dashboard
# 1. Va sur https://dash.cloudflare.com/tunnels
# 2. Crée un nouveau tunnel nommé "wero"
# 3. Configure le hostname vers localhost:3000
# 4. Copie le token d'installation

# Option 2: Via CLI cloudflared
# cloudflared tunnel login
# cloudflared tunnel create wero
# cloudflared tunnel token wero
# (Copie le token complet)

# ============================================
# NOTES
# ============================================
# - Le tunnel se connecte à localhost:3000 (interne)
# - Ton app sera accessible publiquement via Cloudflare
# - HTTPS automatique ✅
# - Pas besoin d'ouvrir les ports ✅
# - Protection DDoS incluse ✅
